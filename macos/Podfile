platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # CocoaPods + Xcode обидва задають POD_CONFIGURATION_DEBUG — Clang лається на macro redefined.
    # Застарілі API у відео-плагінах — лише шум з pub-cache; не блокує збірку.
    target.build_configurations.each do |config|
      next unless config.name == 'Debug'
      flags = config.build_settings['OTHER_CFLAGS']
      extras = %w[-Wno-macro-redefined -Wno-deprecated-declarations]
      if flags.nil?
        config.build_settings['OTHER_CFLAGS'] = ['$(inherited)'] + extras
      elsif flags.is_a?(String)
        unless flags.include?('macro-redefined')
          config.build_settings['OTHER_CFLAGS'] = "#{flags} #{extras.join(' ')}"
        end
      elsif flags.is_a?(Array)
        extras.each do |e|
          flags << e unless flags.any? { |f| f.to_s.include?(e) }
        end
        config.build_settings['OTHER_CFLAGS'] = flags.uniq
      end
    end
    # Apple privacy manifests (*.xcprivacy) must not be in "Compile Sources".
    # Some pods glob `**/*` and Xcode warns: no rule to process file ... 'text.xml'.
    next unless target.respond_to?(:source_build_phase)
    target.source_build_phase.files.to_a.each do |build_file|
      path = build_file.file_ref&.path
      next unless path&.end_with?('.xcprivacy')
      build_file.remove_from_project
    end
  end
end
